# Tipos del modulo escrito en Rust (engine/src/python.rs), para mypy y el editor.

from collections.abc import Sequence

PAGE_SIZE: int
MAX_ROW: int

_Value = int | str | None
_Row = Sequence[_Value | bool]
_Limit = tuple[_Value | bool, bool] | None

class StorageError(Exception): ...

class Engine:
    def __init__(self, path: str) -> None: ...
    def catalog(self) -> list[tuple[str, str, str, str]]: ...
    def create_table(self, name: str, sql: str) -> None: ...
    def create_index(self, name: str, table: str, column: int, sql: str) -> None: ...
    def drop_table(self, name: str) -> None: ...
    def drop_index(self, name: str) -> None: ...
    def insert(self, table: str, rows: Sequence[_Row]) -> list[int]: ...
    def scan(self, table: str) -> list[tuple[int, tuple[_Value, ...]]]: ...
    def search(
        self, index: str, low: _Limit, high: _Limit
    ) -> list[tuple[int, tuple[_Value, ...]]]: ...
    def update(self, table: str, changes: Sequence[tuple[int, _Row]]) -> None: ...
    def delete(self, table: str, rowids: Sequence[int]) -> None: ...
    def clear(self, table: str) -> None: ...
    def commit(self) -> None: ...
    def rollback(self) -> None: ...
    def page_count(self) -> int: ...
    def close(self) -> None: ...
